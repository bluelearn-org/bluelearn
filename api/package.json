{
  "name": "api",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "concurrently -n types,worker -c blue,yellow \"pnpm dev:types\" \"wrangler dev\"",
    "dev:types": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "search:sync": "tsx scripts/typesense-sync.ts"
  },
  "dependencies": {
    "@bluelearn/schemas": "workspace:*",
    "@hono/standard-validator": "^0.2.3",
    "@resvg/resvg-wasm": "^2.6.2",
    "@scalar/hono-api-reference": "^0.11.14",
    "@supabase/supabase-js": "^2.105.4",
    "hono": "^4.12.18",
    "hono-openapi": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250508.0",
    "@eslint/js": "^10.0.1",
    "@types/ajv": "^1.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.6",
    "wrangler": "^4.14.1"
  }
}
